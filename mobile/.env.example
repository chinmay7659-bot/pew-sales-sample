# Optional: Pre-configured Google Sheet Apps Script Web App URL (works out of the box in standalone APKs)
EXPO_PUBLIC_SHEETS_BRIDGE_URL=

# Optional: Pre-configured Google Spreadsheet ID when using Google Sign-In
EXPO_PUBLIC_DEFAULT_SPREADSHEET_ID=

# Optional: Google OAuth Client IDs for direct Google Sign-In on mobile
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional remote backend API base URL (legacy REST mode)
EXPO_PUBLIC_API_BASE_URL=
